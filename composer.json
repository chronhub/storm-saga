{
    "name": "chronhub/storm-saga",
    "description": "Storm Saga — code-first orchestration / process-manager engine (state machine, timers, compensation).",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "saga", "process-manager", "orchestration", "workflow"],
    "require": {
        "php": ">=8.5",
        "chronhub/storm-clock": "self.version",
        "chronhub/storm-contracts": "self.version",
        "chronhub/storm-message": "self.version",
        "chronhub/storm-serializer": "self.version",
        "chronhub/storm-support": "self.version",
        "doctrine/dbal": "^4.0",
        "dragonmantank/cron-expression": "^3.6",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0"
    },
    "suggest": {
        "phpunit/phpunit": "The in-memory runtime assertions (Testing/InMemory) call PHPUnit's Assert — already present wherever the kit runs, inside a test suite."
    },
    "autoload": {
        "psr-4": {
            "Storm\\Saga\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/",
            "/Testing/InMemory/SagaRuntimeAssertions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Saga\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
